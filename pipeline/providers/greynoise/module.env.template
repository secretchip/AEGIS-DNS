# GreyNoise Community IP classifier.
#
# Runtime overrides may be placed in:
#   var/secrets/providers/greynoise.env
#
# IP-only, queue-scoped. Community/free limits are small, so the default
# max requests per run is intentionally conservative.
AEGIS_PROVIDER_ENABLED=false
AEGIS_PROVIDER_REQUIRED_ENV=GREYNOISE_API_KEY
AEGIS_PROVIDER_FAIL_SOFT=true
AEGIS_PROVIDER_INPUT_SCOPE=queue
AEGIS_PROVIDER_ALLOWED_KINDS=ipv4
AEGIS_PROVIDER_RUN_FOR_TARGETED=true
AEGIS_PROVIDER_CACHE_ENABLED=true
AEGIS_PROVIDER_VERSION=1
AEGIS_PROVIDER_MAX_REQUESTS_PER_RUN=10
AEGIS_PROVIDER_REQUEST_DELAY_SECONDS=0
AEGIS_PROVIDER_CACHE_HIT_TTL_DAYS=90
AEGIS_PROVIDER_CACHE_MISS_TTL_DAYS=30
AEGIS_PROVIDER_CACHE_ERROR_TTL_DAYS=1
GREYNOISE_API_KEY=changeme
GREYNOISE_API_URL=https://api.greynoise.io/v3/community
