# VirusTotal v3 classifier.
#
# Runtime overrides may be placed in:
#   var/secrets/providers/virustotal.env
#
# Public API quotas are very small and public API use is not appropriate for
# commercial workflows. This module is disabled by default, queue-scoped, and
# intentionally capped at 4 requests per run unless overridden.
AEGIS_PROVIDER_ENABLED=false
AEGIS_PROVIDER_REQUIRED_ENV=VIRUSTOTAL_API_KEY
AEGIS_PROVIDER_FAIL_SOFT=true
AEGIS_PROVIDER_INPUT_SCOPE=queue
AEGIS_PROVIDER_ALLOWED_KINDS=domain,ipv4
AEGIS_PROVIDER_RUN_FOR_TARGETED=true
AEGIS_PROVIDER_CACHE_ENABLED=true
AEGIS_PROVIDER_VERSION=1
AEGIS_PROVIDER_MAX_REQUESTS_PER_RUN=4
AEGIS_PROVIDER_REQUEST_DELAY_SECONDS=16
AEGIS_PROVIDER_CACHE_HIT_TTL_DAYS=90
AEGIS_PROVIDER_CACHE_MISS_TTL_DAYS=30
AEGIS_PROVIDER_CACHE_ERROR_TTL_DAYS=1
VIRUSTOTAL_API_KEY=changeme
VIRUSTOTAL_API_URL=https://www.virustotal.com/api/v3
VIRUSTOTAL_MALICIOUS_THRESHOLD=2
VIRUSTOTAL_SUSPICIOUS_THRESHOLD=1
