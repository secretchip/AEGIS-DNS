# Local category seed classifier.
#
# Runtime overrides may be placed in:
#   var/secrets/providers/local-seeds.env
#
# This module has no external API dependency. It classifies final block-list
# entries by exact membership in files under AEGIS_LOCAL_SEEDS_DIR.
AEGIS_PROVIDER_ENABLED=true
AEGIS_PROVIDER_REQUIRED_ENV=
AEGIS_PROVIDER_FAIL_SOFT=false
AEGIS_PROVIDER_INPUT_SCOPE=corpus
AEGIS_PROVIDER_RUN_FOR_TARGETED=true
AEGIS_PROVIDER_CACHE_ENABLED=false
AEGIS_PROVIDER_MAX_REQUESTS_PER_RUN=0
AEGIS_PROVIDER_MAX_REQUESTS_PER_MINUTE=0
AEGIS_PROVIDER_CACHE_TTL_DAYS=0
AEGIS_LOCAL_SEEDS_DIR=sources/external-sources
