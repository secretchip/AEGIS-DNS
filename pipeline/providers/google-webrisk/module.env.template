# Google Web Risk URL classifier.
#
# Runtime overrides may be placed in:
#   var/secrets/providers/google-webrisk.env
#
# Queue-scoped. Provide either GOOGLE_WEBRISK_API_KEY or
# GOOGLE_WEBRISK_BEARER_TOKEN. Domain indicators are checked as
# https://<domain>/ because AEGIS stores normalized host indicators.
AEGIS_PROVIDER_ENABLED=false
AEGIS_PROVIDER_REQUIRED_ENV=
AEGIS_PROVIDER_FAIL_SOFT=true
AEGIS_PROVIDER_INPUT_SCOPE=queue
AEGIS_PROVIDER_ALLOWED_KINDS=domain,ipv4
AEGIS_PROVIDER_RUN_FOR_TARGETED=true
AEGIS_PROVIDER_CACHE_ENABLED=true
AEGIS_PROVIDER_VERSION=1
AEGIS_PROVIDER_MAX_REQUESTS_PER_RUN=100
AEGIS_PROVIDER_REQUEST_DELAY_SECONDS=0
AEGIS_PROVIDER_CACHE_HIT_TTL_DAYS=90
AEGIS_PROVIDER_CACHE_MISS_TTL_DAYS=30
AEGIS_PROVIDER_CACHE_ERROR_TTL_DAYS=1
GOOGLE_WEBRISK_API_KEY=changeme
GOOGLE_WEBRISK_BEARER_TOKEN=
GOOGLE_WEBRISK_API_URL=https://webrisk.googleapis.com/v1/uris:search
GOOGLE_WEBRISK_THREAT_TYPES=MALWARE,SOCIAL_ENGINEERING,UNWANTED_SOFTWARE,SOCIAL_ENGINEERING_EXTENDED_COVERAGE
