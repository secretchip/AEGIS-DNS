# Source provenance classifier.
#
# Runtime overrides may be placed in:
#   var/secrets/providers/source-provenance.env
#
# This module classifies entries by the downloaded source URL that originally
# contributed them. It is intended for broad category generation, not targeted
# one-off classification.
AEGIS_PROVIDER_ENABLED=true
AEGIS_PROVIDER_REQUIRED_ENV=
AEGIS_PROVIDER_FAIL_SOFT=false
AEGIS_PROVIDER_INPUT_SCOPE=provenance
AEGIS_PROVIDER_RUN_FOR_TARGETED=false
AEGIS_PROVIDER_CACHE_ENABLED=false
AEGIS_SOURCE_PROVENANCE_DIR=var/intake/block/provenance/current
AEGIS_SOURCE_CATEGORY_MAP=sources/block_source_categories.tsv
