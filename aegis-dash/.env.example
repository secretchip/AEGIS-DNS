# --- AEGIS-DNS Dashboard environment ---

# SQLite database file path
DATABASE_PATH=./data/aegis-dash.sqlite

# iron-session cookie secret — MUST be >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Key used to encrypt per-client auth-config secrets at rest (>= 32 chars).
CONFIG_ENCRYPTION_KEY=change-me-to-another-long-random-string-32chars

# Default DNS endpoint base domain for generated client URLs.
ENDPOINT_BASE=dns.secretchip.net

# Technitium integration mode: "mock" (default, no server needed) or "live".
TECHNITIUM_MODE=mock
# Used only when TECHNITIUM_MODE=live:
TECHNITIUM_HOST=https://aegis.dns.secretchip.net:53444
TECHNITIUM_API_TOKEN=
TECHNITIUM_INSECURE_SSL=false

# Auth mode: "mock" enables the offline mock-SSO round-trip for OIDC clients.
# Set to "live" to use real IdP endpoints from each client's auth config.
AUTH_MODE=mock

# Public base URL of this dashboard (used to build SSO redirect URIs).
APP_BASE_URL=http://localhost:3000
